# Database
# Local SQLite:
DATABASE_URL="file:./dev.db"
# Production (Neon / Postgres) — also set provider = "postgresql" in prisma/schema.prisma:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-in-production"
SESSION_SECRET="generate-a-long-random-string"

# Email (Resend) — optional in local/dev; without key, emails are logged
# RESEND_API_KEY="re_..."
EMAIL_FROM="Salmarina <onboarding@resend.dev>"
RESTAURANT_EMAIL="info@salmarina.ch"

# Reservations capacity / behaviour (optional overrides)
# RESERVATION_AUTO_CONFIRM="false"
# MAX_SEATS_PER_SLOT="40"
# MAX_PARTIES_PER_SLOT="8"
# SLOT_INTERVAL_MINUTES="30"

# Vercel Blob for menu uploads in production (optional)
# BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# Chatbot — v1 is rule-based; optional future LLM enhancement
# OPENAI_API_KEY=
